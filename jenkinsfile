pipeline {
    agent any 

    environment {
        COMPOSE_FILE = 'docker-compose.yml'
        SONAR_HOST = 'http://sonarqube:9000'
        SONAR_TOKEN = credentials('sonar-token')

        DOCKER_IMAGE_BACK = 'todo-backend'
        DOCKER_IMAGE_FRONT = 'taskflow'
        VERSION = "${BUILD_NUMBER}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // =========================
        // TESTS IN PARALLEL
        // =========================
        stage('Tests') {
            parallel {

                stage('Backend Tests') {
                    steps {
                        sh '''
                        cd todo-backend
                        chmod +x mvnw
                        ./mvnw clean verify
                        '''
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        timeout(time: 20, unit: 'MINUTES') {
                            withEnv(['PUPPETEER_SKIP_DOWNLOAD=false']) {
                                sh '''
                                cd taskFlow

                                npm ci --prefer-offline --no-audit --progress=false

                                npm run test -- \
                                  --watch=false \
                                  --code-coverage \
                                  --browsers=ChromeHeadlessNoSandbox \
                                  --source-map=false \
                                  --progress=false
                                '''
                            }
                        }
                    }
                }
            } 
        } 

        // =========================
        // SONAR ANALYSIS
        // =========================
        stage('Sonar Analysis') {
            parallel {

                stage('Backend Sonar') {
                    steps {
                        sh '''
                        cd todo-backend
                        chmod +x mvnw
                        ./mvnw sonar:sonar \
                          -Dsonar.projectKey=todo-backend \
                          -Dsonar.host.url=$SONAR_HOST \
                          -Dsonar.login=$SONAR_TOKEN
                        '''
                    }
                }

                stage('Frontend Sonar') {
                    steps {
                        sh '''
                        cd taskFlow

                        # Fix LCOV paths
                        sed -i "s|SF:src|SF:${WORKSPACE}/taskFlow/src|g" coverage/lcov.info

                        npx sonar-scanner \
                          -Dsonar.projectKey=todo-frontend \
                          -Dsonar.sources=src \
                          -Dsonar.tests=src \
                          -Dsonar.test.inclusions=**/*.spec.ts \
                          -Dsonar.exclusions=**/*.spec.ts \
                          -Dsonar.host.url=$SONAR_HOST \
                          -Dsonar.login=$SONAR_TOKEN \
                          -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info \
                          -Dsonar.sourceEncoding=UTF-8
                        '''
                    }
                }
            }
        }

        // =========================
        // BUILD DOCKER IMAGES
        // =========================
        stage('Build Docker Images') {
            steps {
                sh '''
                docker compose -f $COMPOSE_FILE build

                docker tag backend:1.0 $DOCKER_IMAGE_BACK:$VERSION
                docker tag taskflow:1.0 $DOCKER_IMAGE_FRONT:$VERSION
                '''
            }
        }

        // =========================
        // PUSH TO DOCKER HUB
        // =========================
        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                    docker tag $DOCKER_IMAGE_BACK:$VERSION $DOCKER_USER/$DOCKER_IMAGE_BACK:latest
                    docker tag $DOCKER_IMAGE_FRONT:$VERSION $DOCKER_USER/$DOCKER_IMAGE_FRONT:latest

                    docker push $DOCKER_USER/$DOCKER_IMAGE_BACK:latest
                    docker push $DOCKER_USER/$DOCKER_IMAGE_FRONT:latest

                    docker logout
                    '''
                }
            }
        }

        // =========================
        // DEPLOY TO KUBERNETES
        // =========================
        stage('Deploy') {
            steps {
                sh '''
                echo "🚀 Deploying to Kubernetes..."

                # Ensure namespace exists
                kubectl get ns task-flow || kubectl create ns task-flow

                # Apply all manifests
                kubectl apply -f k8s/ -n task-flow

                echo "⏳ Waiting for database..."
                kubectl rollout status deployment/taskflow-db -n task-flow --timeout=120s

                echo "⏳ Waiting for backend..."
                kubectl rollout status deployment/backend -n task-flow --timeout=120s

                echo "⏳ Waiting for frontend..."
                kubectl rollout status deployment/frontend -n task-flow --timeout=120s

                echo "📦 Checking pods status..."
                kubectl get pods -n task-flow

                # FAIL PIPELINE IF SOMETHING IS WRONG
                if kubectl get pods -n task-flow | grep -E 'Pending|CrashLoopBackOff'; then
                  echo "❌ Deployment failed"
                  exit 1
                fi

                echo "✅ Deployment successful"
                '''
            }
        }
    }

    post {
        always {
            sh 'docker compose logs || true'
        }

        success {
            echo "🎉 Pipeline SUCCESS"
        }

        failure {
            echo "❌ Pipeline FAILED"
        }
    }
}
